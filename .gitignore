dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# Dataset (too large — 46GB) - KEEP LOCAL
dataset/

# Landmark caches (regenerated automatically) - KEEP LOCAL
landmark_cache/
landmark_interpolation_cache/
landmark_pose_cache/
landmark_cache_full/

# Local user personalization data (never upload by default)
data/personalization/

# Model checkpoints - Ignore training runs & heavy external TTS weights
trained_models/demo_50/
trained_models/full_2731/*
!trained_models/full_2731/exp9_true_arcface/
trained_models/tts/

# Whitelist best integrated models for production deployment
!trained_models/production/
!trained_models/production/best_model.pth
!trained_models/production/model_metadata.json
!trained_models/best_gru_normalized.pth
!trained_models/full_2731/exp9_true_arcface/best_model.pth

# Generated speech cache
signbridge/web/static/audio/*.wav
!signbridge/web/static/audio/.gitkeep

# Internal agent caches & symlinks
.kilo/
signbridge_p

# Environment variables & secrets
.env
*.env
.env.*
!*.env.example

